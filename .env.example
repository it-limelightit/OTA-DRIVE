POSTGRES_DB=limelight_ota
POSTGRES_USER=limelight
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://limelight:change-me-local-only@localhost:5432/limelight_ota
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@limelight.local
ADMIN_PASSWORD=ChangeThisLocalAdminPassword123!
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=ota-backend
MQTT_PASSWORD=change-me-mqtt
# Comma-separated bridge devices that use private MinIO OTA. All others keep
# the legacy ota.check -> OTAdrive route. Leave empty until a bridge is flashed.
PRIVATE_OTA_DEVICE_IDS=
S3_ENDPOINT=http://localhost:9000
# Device-reachable endpoint used when signing firmware download URLs.
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_BUCKET=firmware
S3_ACCESS_KEY=limelight-dev
S3_SECRET_KEY=change-me-minio
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
FIRMWARE_URL_TTL_SECONDS=900
FIRMWARE_MAX_UPLOAD_BYTES=16777216
