# Docker network names from `docker network ls` on the VPS.
POSTGRES_NETWORK=banaskantha-infra_default
OTA_INFRA_NETWORK=ota_drive_default

# Use the existing PostgreSQL container and the OTA project's own database.
DATABASE_URL=postgres://limelight_ota_user:REPLACE_WITH_PASSWORD@banaskantha-postgres:5432/limelight_ota

JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Cloudflare-hosted frontend origin. Use the temporary Pages domain first,
# then replace it with your custom frontend domain later.
CORS_ORIGIN=https://your-project.pages.dev

# Existing OTA infrastructure containers, reached over OTA_INFRA_NETWORK.
MQTT_URL=mqtt://ota_drive-mosquitto-1:1883
MQTT_USERNAME=REPLACE_IF_MQTT_AUTH_IS_ENABLED
MQTT_PASSWORD=REPLACE_IF_MQTT_AUTH_IS_ENABLED
MQTT_ONLINE_THRESHOLD_SECONDS=300

S3_ENDPOINT=http://ota_drive-minio-1:9000
# HTTPS hostname that ESP devices can reach. Do not use a Docker container name here.
S3_PRESIGN_ENDPOINT=https://minio.your-domain.com
S3_BUCKET=firmware
S3_ACCESS_KEY=REPLACE_WITH_EXISTING_MINIO_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_EXISTING_MINIO_SECRET_KEY
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=false
FIRMWARE_URL_TTL_SECONDS=900
FIRMWARE_MAX_UPLOAD_BYTES=16777216
